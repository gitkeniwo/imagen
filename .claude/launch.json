{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "uvicorn",
        "app.main:app",
        "--port",
        "8000"
      ],
      "cwd": "backend",
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "cwd": "frontend",
      "port": 5173
    },
    {
      "name": "dummy",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "IMAGEN_DATA_DIR=/tmp/imagen-dummy uv run uvicorn app.main:app --port 8033"
      ],
      "cwd": "backend",
      "port": 8033
    }
  ]
}
