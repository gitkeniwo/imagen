{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Imagen",
  "version": "0.2.2",
  "identifier": "com.gitkeniwo.imagen",
  "mainBinaryName": "Imagen",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "resources": {
      "resources/imagen-backend/": "imagen-backend/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    }
  }
}
